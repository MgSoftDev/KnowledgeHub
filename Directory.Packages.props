<Project>

  <ItemGroup>
    <!-- MgSoftDev -->
    <PackageVersion Include="MgSoftDev.Returning" Version="1.2.0" />
    <PackageVersion Include="MgSoftDev.PrismPlus.Returning" Version="1.0.8" />

    <!-- HTML sanitization (optional add-on package) -->
    <PackageVersion Include="HtmlSanitizer" Version="9.1.968-beta" />
    <!-- Transitive of HtmlSanitizer; referenced directly to pre-process the DOM before sanitizing. -->
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
    <!-- Motor de PDF: Chromium. Subir esta versión CAMBIA el navegador que se descarga, así que en
         despliegues con el navegador empaquetado hay que rehacer el instalador. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.59.0" />
    <!-- Motor de plantillas. NO bajar de 7.2.0: hasta la 7.1.0 inclusive, array.insert_at ignora
         LoopLimit y LimitToString y tumba el proceso por OOM (GHSA-24c8-4792-22hx y 3 avisos más),
         que es justo lo que el contexto endurecido intenta impedir. -->
    <PackageVersion Include="Scriban" Version="7.2.6" />

    <!-- Imaging / storage engines -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />

    <!-- Blazor / UI -->
    <PackageVersion Include="Radzen.Blazor" Version="11.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.80" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />

    <!-- Logging (demos) -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
