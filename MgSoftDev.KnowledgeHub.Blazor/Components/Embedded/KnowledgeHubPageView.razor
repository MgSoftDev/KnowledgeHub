@* Lector de una página publicada. Embebible: pásale PagePk y, opcionalmente, callbacks para
   que las acciones (editar/permisos/gestionar/historial) las maneje tu app en vez de navegar. *@

@if (Loading)
{
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
}
else if (ErrorMessage is not null)
{
    <div class="kh-doc-content">
        <h1>No disponible</h1>
        <p style="color:#c62828;">@ErrorMessage</p>
        @if (ShowActions && User.CanEdit())
        {
            <p style="color:#6b7280;">Puedes editar esta página y publicarla para que sea visible.</p>
            <div style="display:flex;gap:6px;margin-top:8px;">
                <RadzenButton Text="Editar" Icon="edit" Size="ButtonSize.Small" Click="@GoEdit" />
                <RadzenButton Text="Permisos" Icon="lock" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light" Click="@GoPermissions" />
                <RadzenButton Text="Gestionar" Icon="settings" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light" Click="@GoManage" />
            </div>
        }
    </div>
}
else if (Page is not null)
{
    @* El panel «En esta página» es HERMANO de .kh-doc-content, no hijo: esa clase la comparten 11
       componentes y su max-width ES la columna de lectura, así que meterlo dentro la estrecharía
       en todos ellos. *@
    <div class="kh-doc-layout" @ref="_layoutElement">
    <div class="kh-doc-row">
    <div class="kh-doc-content">
        @if (!string.IsNullOrWhiteSpace(Page.Icon))
        {
            <div class="kh-doc-title-row">
                <KnowledgeHubPageIcon Icon="@Page.Icon" IconColor="@Page.IconColor" ShowFallback="false" />
                <strong>@Page.Title</strong>
            </div>
        }
        @if (ShowActions)
        {
            <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;" class="kh-doc-meta">
                <span>
                    Versión @Page.VersionNumber
                    @if (Page.PublishedAt is not null)
                    {
                        <span> · Publicada el @Page.PublishedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </span>
                <span style="display:flex;gap:6px;">
                    @if (User.CanEdit())
                    {
                        <RadzenButton Text="Editar" Icon="edit" Size="ButtonSize.ExtraSmall" Click="@GoEdit" />
                        <RadzenButton Text="Permisos" Icon="lock" Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Light" Click="@GoPermissions" />
                        <RadzenButton Text="Gestionar" Icon="settings" Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Light" Click="@GoManage" />
                    }
                    <RadzenButton Text="Historial" Icon="history" Size="ButtonSize.ExtraSmall"
                                  ButtonStyle="ButtonStyle.Light" Click="@GoHistory" />
                    @if (CanExport)
                    {
                        @* Pulsar el botón exporta solo esta página; el desplegable ofrece la rama. *@
                        <RadzenSplitButton Text="@(Exporting ? "Generando…" : "PDF")" Icon="picture_as_pdf"
                                           Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                           Disabled="@Exporting" Click="@OnExportClick">
                            <ChildContent>
                                <RadzenSplitButtonItem Text="Solo esta página" Value="page" />
                                <RadzenSplitButtonItem Text="Con sus subpáginas" Value="branch" />
                            </ChildContent>
                        </RadzenSplitButton>
                    }
                </span>
            </div>
        }
        @((MarkupString)RenderedHtml)
    </div>

    @if (ShowOutlinePanel)
    {
        <aside class="kh-doc-toc @(OutlineCollapsed ? "kh-doc-toc-folded" : null)">
            <button type="button" class="kh-doc-toc-toggle" @onclick="ToggleOutlineAsync"
                    aria-expanded="@(OutlineCollapsed ? "false" : "true")"
                    title="@(OutlineCollapsed ? "Mostrar el índice" : "Ocultar el índice")">
                <RadzenIcon Icon="@(OutlineCollapsed ? "chevron_right" : "expand_more")" />
                <span>En esta página</span>
            </button>
            @if (!OutlineCollapsed)
            {
                @* Botones y no <a href="#ancla">: el router de Blazor intercepta los fragmentos y
                   cambiaría la URL —lo que despierta al árbol, que escucha LocationChanged— y
                   encima no haría scroll, porque quien scrollea es un div, no la ventana. *@
                <nav class="kh-doc-toc-list" aria-label="En esta página">
                    @foreach (var heading in Headings)
                    {
                        <button type="button" data-kh-anchor="@heading.Id"
                                class="kh-doc-toc-link kh-doc-toc-l@(heading.Level)"
                                @onclick="@(() => GoToHeadingAsync(heading.Id))">@heading.Text</button>
                    }
                </nav>
            }
        </aside>
    }
    </div>
    </div>
}
