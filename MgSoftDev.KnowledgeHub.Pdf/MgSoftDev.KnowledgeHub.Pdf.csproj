<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MgSoftDev.KnowledgeHub.Pdf</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Default PDF exporter for MgSoftDev.KnowledgeHub, built on PDFsharp/MigraDoc (MIT). Turns published pages — a single page or a whole branch — into a PDF with cover, table of contents, page numbers and bookmarks, resolving stored WebP images. Fully managed, no external binaries. Optional: register it to enable the export button, or implement IKnowledgeHubPdfRenderer yourself.</Description>
    <PackageTags>knowledgehub;pdf;export;migradoc;pdfsharp;mgsoftdev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MgSoftDev.KnowledgeHub.Abstractions\MgSoftDev.KnowledgeHub.Abstractions.csproj" />
  </ItemGroup>

</Project>
